APP_NAME="Jay Malhar Dairy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Web uses its own API automatically. Desktop can use the deployed web API.
API_BASE_URL=
DESKTOP_API_BASE_URL=http://localhost:8000/api

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dairy_app
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow/
MSG91_AUTHKEY=your-msg91-authkey
MSG91_COLLECTION_TEMPLATE_ID=6a43ce4b1f159b9584063193
SMS_DAIRY_NAME="Jay Malhar Dairy"
SMS_SENDER_ID=DAIRY
DLT_ENTITY_ID=your-entity-id
DLT_TEMPLATE_ID=your-template-id

# Approved MSG91 invoice flow: var1=name, var2=invoice number, var3=net amount
MSG91_INVOICE_TEMPLATE_ID=
